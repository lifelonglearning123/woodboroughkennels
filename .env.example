# GoHighLevel — copy to .env.local for local dev (`vercel dev`),
# and add the same two variables in the Vercel dashboard for production.
# .env.local is gitignored; never commit real values.

# Sub-account / location ID — GHL Settings > Business Profile
GHL_LOCATION_ID=

# Private Integration Token — GHL Settings > Private Integrations
# Scopes required: contacts.write, contacts.readonly
GHL_TOKEN=
