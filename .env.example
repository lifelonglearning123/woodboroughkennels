# GoHighLevel — copy to .env.local for local dev (`vercel dev`),
# and add the same variable in the Vercel dashboard for production.
# .env.local is gitignored; never commit real values.

# Optional. Inbound webhook URL from the GHL workflow trigger
# (Automation > Workflows > Inbound Webhook). When unset,
# api/enquiry.js uses the URL hard-coded in DEFAULT_WEBHOOK.
GHL_WEBHOOK_URL=
